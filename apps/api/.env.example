APP_ENV="development"

# JWT
JWT_SECRET="your-super-secret-jwt-secret"

# Database
DB_URL="jdbc:mysql://localhost:3306/travel_db"
DB_USER="user"
DB_PASSWORD="password"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# S3/MinIO
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="travel-images"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# File Upload
UPLOAD_PROVIDER="local" # local or s3
LOCAL_UPLOAD_PATH="assets/uploads"
LOCAL_UPLOAD_BASE_URL="http://localhost:8080/uploads"
AWS_S3_BUCKET="your-s3-bucket"
AWS_S3_REGION="your-s3-region"
AWS_S3_ACCESS_KEY="your-s3-access-key"
AWS_S3_SECRET_KEY="your-s3-secret-key"
AWS_CLOUDFRONT_DOMAIN="" # Optional: "https://your-cloudfront-domain.com"
